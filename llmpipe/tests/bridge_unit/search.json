[
{
  "id": "u01_supplied_by_unit_fact",
  "purpose": "positive goal supplied directly by a ground unit fact",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": ["isa", "elephant", "#:John 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "elephant", "#:John 1"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "the base case; a unit clause whose only literal unifies ends the path"
},
{
  "id": "u02_supplied_through_one_rule",
  "purpose": "goal matches a rule conclusion whose single body literal is a fact",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "elephant", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S2", "@logic": ["isa", "elephant", "#:John 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "animal", "#:John 1"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "one recursion step; the body literal's complement becomes the subgoal"
},
{
  "id": "u03_gap_at_unsatisfied_guard",
  "purpose": "rule conclusion matches but a body guard has no producer (case-107 shape)",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "gre applicant", "?:X"], ["have", "?:X", "#:financial aid 1"]]},
    {"@name": "sent_S2", "@logic": ["isa", "person", "#:Tom 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["have", "#:Tom 1", "#:financial aid 1"]},
  "expect": {"result": "GAPS",
             "gaps": [[{"sign": "+", "atom": ["isa", "gre applicant", "#:Tom 1"],
                        "reason": "no_predicate_match"}]]},
  "notes": "the guard surfaces at depth 1 with the substitution applied; this is what generalises check_unsatisfiable_guards"
},
{
  "id": "u04_negative_goal_via_negative_conclusion_clause",
  "purpose": "clause with NO positive literal supplies a negative goal (modus tollens)",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "elephant", "?:X"], ["-isa", "bird", "?:X"]]},
    {"@name": "sent_S2", "@logic": ["isa", "elephant", "#:Jumbo 1"]}
  ],
  "start_goal": {"sign": "-", "atom": ["isa", "bird", "#:Jumbo 1"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "THE reason the search must be signed: a positive-conclusion-only scan sees no head here and would miss much of FOLIO's False reasoning"
},
{
  "id": "u05_negative_goal_via_negative_fact",
  "purpose": "negative unit fact supplies a negative goal",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": ["-has property", "happy", "#:Mary 1"]}
  ],
  "start_goal": {"sign": "-", "atom": ["has property", "happy", "#:Mary 1"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "the shape antonym folding produces (unhappy -> -happy), verified live"
},
{
  "id": "u06_defq_question_traversal",
  "purpose": "start from the real @question goal and traverse the $defq encoding",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "elephant", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S2", "@sourcetype": "question",
     "@logic": [["-$defq0"], ["-isa", "elephant", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S2", "@sourcetype": "question",
     "@logic": [["isa", "elephant", "sk0_elephant"], ["$defq0"]]},
    {"@name": "sent_S2", "@sourcetype": "question",
     "@logic": [["-isa", "animal", "sk0_elephant"], ["$defq0"]]},
    {"@name": "sent_S2", "@question": ["$defq0"]}
  ],
  "start_goal": {"sign": "+", "atom": ["$defq0"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "clause shapes copied verbatim from stored core case 1; $defq is traversed, not treated as an opaque control atom"
},
{
  "id": "u07_two_alternatives_one_complete",
  "purpose": "two clauses supply the goal; one path completes, so the goal is SUPPLIED",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "cat", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S2", "@logic": [["-isa", "dog", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S3", "@logic": ["isa", "dog", "#:Rex 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "animal", "#:Rex 1"]},
  "expect": {"result": "SUPPLIED"},
  "notes": "a failed alternative must not be reported as a gap while another alternative supplies the goal"
},
{
  "id": "u08_two_alternatives_both_incomplete",
  "purpose": "both supplying clauses leave a gap; the two gaps are ALTERNATIVES, not a conjunction",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "cat", "?:X"], ["isa", "animal", "?:X"]]},
    {"@name": "sent_S2", "@logic": [["-isa", "dog", "?:X"], ["isa", "animal", "?:X"]]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "animal", "#:Rex 1"]},
  "expect": {"result": "GAPS",
             "gaps": [[{"sign": "+", "atom": ["isa", "cat", "#:Rex 1"],
                        "reason": "no_predicate_match"}],
                      [{"sign": "+", "atom": ["isa", "dog", "#:Rex 1"],
                        "reason": "no_predicate_match"}]]},
  "notes": "bridging EITHER gap would close the proof; a flat gap list would wrongly suggest both are needed"
},
{
  "id": "u09_conjunctive_gaps_in_one_alternative",
  "purpose": "one supplying clause with two unmet body literals: both gaps required together",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "student", "?:X"], ["-is rel2", "in", "?:X", "#:Vellmar 1"], ["has property", "eligible", "?:X"]]},
    {"@name": "sent_S2", "@logic": ["isa", "person", "#:Ingrid 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["has property", "eligible", "#:Ingrid 1"]},
  "expect": {"result": "GAPS",
             "gaps": [[{"sign": "+", "atom": ["isa", "student", "#:Ingrid 1"],
                        "reason": "no_predicate_match"},
                       {"sign": "+", "atom": ["is rel2", "in", "#:Ingrid 1", "#:Vellmar 1"],
                        "reason": "no_predicate_match"}]]},
  "notes": "one alternative containing two gaps; bridging only one of them does not close the proof"
},
{
  "id": "u10_cycle_is_limited_not_a_gap",
  "purpose": "self-referential rule must terminate as LIMITED, never as a semantic gap",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "animal", "?:X"], ["isa", "animal", "?:X"]]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "animal", "#:Rex 1"]},
  "expect": {"result": "LIMITED", "reason": "cycle"},
  "notes": "if a cycle were reported as a gap the judge would be asked to bridge the search's own loop"
},
{
  "id": "u11_depth_limit_is_limited",
  "purpose": "a chain longer than max_depth terminates as LIMITED",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-p1", "?:X"], ["p0", "?:X"]]},
    {"@name": "sent_S2", "@logic": [["-p2", "?:X"], ["p1", "?:X"]]},
    {"@name": "sent_S3", "@logic": [["-p3", "?:X"], ["p2", "?:X"]]},
    {"@name": "sent_S4", "@logic": [["-p4", "?:X"], ["p3", "?:X"]]},
    {"@name": "sent_S5", "@logic": [["-p5", "?:X"], ["p4", "?:X"]]},
    {"@name": "sent_S6", "@logic": [["-p6", "?:X"], ["p5", "?:X"]]},
    {"@name": "sent_S7", "@logic": [["-p7", "?:X"], ["p6", "?:X"]]},
    {"@name": "sent_S8", "@logic": [["-p8", "?:X"], ["p7", "?:X"]]}
  ],
  "start_goal": {"sign": "+", "atom": ["p0", "#:a 1"]},
  "expect": {"result": "LIMITED", "reason": "max_depth"},
  "notes": "with max_depth 6 the chain is cut before p8; the cut is reported, not disguised as a gap"
},
{
  "id": "u12_block_clause_is_unsupported",
  "purpose": "a clause carrying a $block literal is out of v1 scope",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "bird", "?:X"], ["has property", "flying", "?:X"], ["$block", ["-has property", "flying", "?:X"]]]},
    {"@name": "sent_S2", "@logic": ["isa", "bird", "#:Tweety 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["has property", "flying", "#:Tweety 1"]},
  "expect": {"result": "UNSUPPORTED", "reason": "block_literal"},
  "notes": "defeasible machinery is deliberately not interpreted by the v1 locator"
},
{
  "id": "u13_non_ground_goal_is_unsupported",
  "purpose": "v1 handles ground yes/no goals only",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": ["isa", "elephant", "#:John 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "elephant", "?:X"]},
  "expect": {"result": "UNSUPPORTED", "reason": "non_ground_goal"},
  "notes": "existentially closing it would change what is being asked, so it is collected for v2 instead"
},
{
  "id": "u14_multi_positive_clause_is_unsupported",
  "purpose": "a disjunctive fact (two positive literals) is out of v1 scope",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["isa", "cat", "#:Pet 1"], ["isa", "dog", "#:Pet 1"]]}
  ],
  "start_goal": {"sign": "+", "atom": ["isa", "cat", "#:Pet 1"]},
  "expect": {"result": "UNSUPPORTED", "reason": "multi_positive_clause"},
  "notes": "selecting one positive literal and complementing the other would assert -isa(dog,Pet), which the clause does not license"
},
{
  "id": "u15_argument_clash_is_a_gap_with_near_misses",
  "purpose": "same predicate and concept word but the entity arguments cannot unify",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": ["is rel2", "written by", "#:Family History 1", "#:Dani 1"]}
  ],
  "start_goal": {"sign": "+", "atom": ["is rel2", "written by", "#:Family History 1", "#:Ravi 1"]},
  "expect": {"result": "GAPS",
             "gaps": [[{"sign": "+", "atom": ["is rel2", "written by", "#:Family History 1", "#:Ravi 1"],
                        "reason": "arguments_clash"}]]},
  "notes": "the entity-split family; the near-miss literal is recorded with the gap so the template stage can see it"
},
{
  "id": "u16_ctxt_must_unify_exactly",
  "purpose": "$ctxt is an ordinary term, never a wildcard",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": ["has property", "tall", "#:Ravi 1", ["$ctxt", "past", "W0", "?:Fv1", "?:Fv2"]]}
  ],
  "start_goal": {"sign": "+", "atom": ["has property", "tall", "#:Ravi 1", ["$ctxt", "present", "W0", "?:Fv1", "?:Fv2"]]},
  "expect": {"result": "GAPS",
             "gaps": [[{"sign": "+", "atom": ["has property", "tall", "#:Ravi 1", ["$ctxt", "present", "W0", "?:Fv1", "?:Fv2"]],
                        "reason": "arguments_clash"}]]},
  "notes": "wildcarding $ctxt would both hide real tense/world breaks and let a later bridge silently change context"
},
{
  "id": "u17_variable_to_variable_unification",
  "purpose": "variables unify with variables, constants and compound terms",
  "final_clauses": [
    {"@name": "sent_S1", "@logic": [["-isa", "activity", "?:E"], ["has type", "?:E", "fly", ["$ctxt", "present", "W0", "?:Fv1", "?:Fv2"]]]},
    {"@name": "sent_S2", "@logic": ["isa", "activity", "sk0_activity"]}
  ],
  "start_goal": {"sign": "+", "atom": ["has type", "sk0_activity", "fly", ["$ctxt", "present", "W0", "?:Fv1", "?:Fv2"]]},
  "expect": {"result": "SUPPLIED"},
  "notes": "the skolem constant binds the rule variable and the binding must carry into the body subgoal"
}
]

     }
    }
   ]
  },
  "notes": "shape copied from a stored FOLIO clause; the event variable is shared across negative literals of one clause"
 },
 {
  "id": "e03_flat_is_rel2_with_eventprop_object",
  "purpose": "flatroles encoding: the event is folded into is rel2 with an eventprop-tagged object",
  "final_clauses": [
   {
    "@name": "sent_S1",
    "@logic": [
     [
      "-is rel2",
      "in",
      "?:X",
      "this club",
      "?:Cu2"
     ],
     [
      "-is rel2",
      "perform",
      "?:X",
      [
       "eventprop",
       "$target",
       "school talent show"
      ],
      "?:Cu2"
     ],
     [
      "is rel2",
      "attend",
      "?:X",
      [
       "eventprop",
       "$target",
       "school event"
      ],
      "?:Cu2"
     ]
    ]
   }
  ],
  "expect": {
   "events": [
    {
     "encoding": "flatroles",
     "verb": "perform",
     "subject": "?:X",
     "object": [
      "eventprop",
      "$target",
      "school talent show"
     ],
     "role_tag": "$target"
    },
    {
     "encoding": "flatroles",
     "verb": "attend",
     "subject": "?:X",
     "object": [
      "eventprop",
      "$target",
      "school event"
     ],
     "role_tag": "$target"
    }
   ]
  },
  "notes": "shape copied from a stored ultracoarse2 clause; an extractor that only understands has type + roles would see no event here at all"
 },
 {
  "id": "e04_flat_is_rel2_plain_object",
  "purpose": "flat encoding without role tagging: plain binary relation",
  "final_clauses": [
   {
    "@name": "sent_S1",
    "@logic": [
     "is rel2",
     "fly",
     "#:Susan 1",
     "#:LaGuardia 1",
     "?:Cu2"
    ]
   }
  ],
  "expect": {
   "events": [
    {
     "encoding": "flat",
     "verb": "fly",
     "subject": "#:Susan 1",
     "object": "#:LaGuardia 1",
     "role_tag": null
    }
   ]
  },
  "notes": "case-180 shape: indistinguishable from a non-event relation at the literal level, which is exactly why the event/relation split blocks proofs"
 },
 {
  "id": "e05_compact_davidson_event_term",
  "purpose": "davidson encoding: one event(...) literal carrying verb, actor, object and handle",
  "final_clauses": [
   {
    "@name": "sent_S1",
    "@logic": [
     "event",
     "write",
     "#:Dani 1",
     "#:Family History 1",
     "sk0_activity"
    ]
   }
  ],
  "expect": {
   "events": [
    {
     "encoding": "davidson",
     "verb": "write",
     "actor": "#:Dani 1",
     "object": "#:Family History 1",
     "event_term": "sk0_activity"
    }
   ]
  },
  "notes": "the structure-preserving fold; needs its own named handler, since neither the has type grouping nor the is rel2 reader recognises it"
 },
 {

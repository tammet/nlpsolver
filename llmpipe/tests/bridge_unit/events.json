[
 {
  "id": "e01_neodavidson_has_type_plus_roles",
  "purpose": "default encoding: an event is a group of literals sharing one event term",
  "final_clauses": [
   {
    "@name": "sent_S1",
    "@logic": [
     "isa",
     "activity",
     "sk0_activity"
    ]
   },
   {
    "@name": "sent_S1",
    "@logic": [
     "has type",
     "sk0_activity",
     "write",
     [
      "$ctxt",
      "past",
      "W0",
      "?:Fv1",
      "?:Fv2"
     ]
    ]
   },
   {
    "@name": "sent_S1",
    "@logic": [
     "has actor",
     "sk0_activity",
     "#:Dani 1",
     [
      "$ctxt",
      "past",
      "W0",
      "?:Fv1",
      "?:Fv2"
     ]
    ]
   },
   {
    "@name": "sent_S1",
    "@logic": [
     "has target",
     "sk0_activity",
     "#:Family History 1",
     [
      "$ctxt",
      "past",
      "W0",
      "?:Fv1",
      "?:Fv2"
     ]
    ]
   }
  ],
  "expect": {
   "events": [
    {
     "encoding": "neodavidson",
     "event_term": "sk0_activity",
     "verb": "write",
     "roles": {
      "actor": "#:Dani 1",
      "target": "#:Family History 1"
     }
    }
   ]
  },
  "notes": "grouping key is the shared event term; the verb sits in argument 2 of has type, not argument 1. Measured caveat (see memos/MEMO_2026_08_07_event_shape_inventory.md): a whole group inside one clause like this is the minority case; see e07 for the dominant split-across-clauses shape"
 },
 {
  "id": "e02_neodavidson_inside_one_rule_clause",
